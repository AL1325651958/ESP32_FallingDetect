CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# The VL53L8CX ULD needs one target per zone for the first bring-up.
CONFIG_VL53L8CX_NB_TARGET_PER_ZONE=1
CONFIG_VL53L8CX_I2C_TIMEOUT=y
CONFIG_VL53L8CX_I2C_TIMEOUT_VALUE=1000
CONFIG_VL53L8CX_RESET_PIN_LOW=y

CONFIG_FALLINGDETECT_I2C_SDA_GPIO=2
CONFIG_FALLINGDETECT_I2C_SCL_GPIO=1
CONFIG_FALLINGDETECT_SENSOR_INT_GPIO=20

# Optimize the expanded neural-network inference for runtime speed.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_FALLINGDETECT_FALL_ENABLED=y
# CONFIG_FALLINGDETECT_RPS_ENABLED is not set
